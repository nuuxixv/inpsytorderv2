      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/slow-preview.mjs",
        "--kbps",
        "120",
        "--latency",
        "800",
        "--port",
        "4277",
        "--cold"
      ],
      "port": 4277,
      "cwd": "inpsyt-order-frontend"
